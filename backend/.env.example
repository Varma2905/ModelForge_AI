# Backend Environment Variables
# Copy this file to `.env` and fill in at least ONE API key to enable the
# real-time AI Assistant. Without a key, the AI endpoints respond with a
# "not configured" error instead of ever using a fake/mock reply.

# --- Google Gemini (Recommended — free tier available) ---
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# --- OpenAI (GPT-4) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB connection (leave as default for local JSON fallback)
MONGODB_URI=mongodb://localhost:27017

# --- Authentication ---
# CHANGE THIS in production. Used to sign JWT session tokens.
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8001

# Max dataset upload size in megabytes
MAX_UPLOAD_MB=100

# --- Data Sources (external database connections) ---
# Encrypts saved database credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes every previously-saved connection undecryptable.
DATA_SOURCE_ENCRYPTION_KEY=

# --- Hugging Face Hub (Model discovery) ---
# Optional — public model search/metadata works without it. Only needed for
# gated/private models or to raise Hub rate limits.
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=
