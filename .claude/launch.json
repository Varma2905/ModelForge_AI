{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d frontend && bun run dev"],
      "port": 3001
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8001"],
      "port": 8001
    }
  ]
}
