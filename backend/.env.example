# Backend Environment Variables
# Copy this file to `.env` and fill in HF_TOKEN to enable the AI Assistant.
# Without it, the AI endpoints respond with a "not configured" error instead
# of ever using a fake/mock reply.

# --- Hugging Face Inference API (AI Assistant's ONLY LLM provider) ---
# Get a token at: https://huggingface.co/settings/tokens
# This same token also powers the Hugging Face Hub model search/import
# feature elsewhere in the app (see app/hf/client.py) — one token, two uses.
# Required. Never expose this value to the frontend/browser, and never
# commit a real token here — this file is a template, not the real .env.
HF_TOKEN=your_huggingface_token
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Authentication ---
# CHANGE THIS in production. Used to sign JWT session tokens.
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8001

# Max dataset upload size in megabytes
MAX_UPLOAD_MB=100

# Leave unset (or "false") for local HTTP development. Set to "true" in
# production, behind a TLS-terminating proxy/load balancer that sets
# X-Forwarded-Proto — rejects any request that arrives over plain HTTP.
REQUIRE_HTTPS=false

# --- Dataset Sources ---
# Note: uploaded/imported dataset CONTENT is never stored in a database
# regardless of these settings — it lives on the filesystem under
# backend/app/data/datasets/. These only control the optional Kaggle/Google
# Drive *import* sources; without them, those source cards show "requires
# configuration" and local upload / manual creation still work fully.

# Kaggle has no third-party OAuth flow, so there is nothing to configure
# here for it — the app never uses a shared/personal Kaggle credential.
# Each platform user connects their OWN Kaggle account from the Dataset
# Source Hub UI (username + personal API key from
# https://www.kaggle.com/settings -> API -> "Create New Token"), which is
# encrypted and stored per-user — see INTEGRATION_ENCRYPTION_KEY below.

# Google Drive OAuth (both required to enable the "Google Drive" source
# card). Create an OAuth 2.0 Client ID at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8001/datasets/google-drive/callback

# Frontend origin to redirect back to once the Google Drive OAuth consent
# flow completes.
FRONTEND_URL=http://localhost:3001

# --- Per-user integration credential encryption ---
# Required before any user can "Connect Kaggle" (their username + API key
# are encrypted with this before being stored). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key after users have connected accounts invalidates their
# stored credentials — they'll need to reconnect.
INTEGRATION_ENCRYPTION_KEY=
